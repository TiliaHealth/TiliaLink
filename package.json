    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/bun": "^1.3.10",
    "@types/jsdom": "^28.0.0",
    "jsdom": "^28.1.0",
    "rollup": "^4.59.0",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
