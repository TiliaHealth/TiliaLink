{
  "name": "@tilia/tilia-link",
  "version": "2.1.2",
  "description": "TiliaLab Communication Bridge & Telemetry Library",
  "main": "dist/tilia-link.js",
  "module": "dist/tilia-link.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
